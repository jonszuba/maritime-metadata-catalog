@prefix : <https://example.org/maritime/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://example.org/maritime/ontology#> .

<https://example.org/maritime/ontology> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  https://example.org/maritime/ontology#generatedBy
:generatedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :IndustrialSignal ;
             rdfs:range :Sensor .


###  https://example.org/maritime/ontology#locatedAt
:locatedAt rdf:type owl:ObjectProperty ;
           rdfs:domain :Machine ;
           rdfs:range :ProductionCell .


###  https://example.org/maritime/ontology#partOf
:partOf rdf:type owl:ObjectProperty ;
        rdfs:domain :PhysicalAsset ;
        rdfs:range :PhysicalAsset .


#################################################################
#    Data properties
#################################################################

###  https://example.org/maritime/ontology#assetIdentifier
:assetIdentifier rdf:type owl:DatatypeProperty ;
                 rdfs:domain :PhysicalAsset ;
                 rdfs:range xsd:string .


###  https://example.org/maritime/ontology#measurementUnit
:measurementUnit rdf:type owl:DatatypeProperty ;
                 rdfs:domain :IndustrialSignal ;
                 rdfs:range xsd:string .


###  https://example.org/maritime/ontology#signalIdentifier
:signalIdentifier rdf:type owl:DatatypeProperty ;
                  rdfs:domain :IndustrialSignal ;
                  rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  https://example.org/maritime/ontology#Facility
:Facility rdf:type owl:Class ;
          rdfs:subClassOf :PhysicalAsset .


###  https://example.org/maritime/ontology#IndustrialSignal
:IndustrialSignal rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty :generatedBy ;
                                    owl:someValuesFrom :Sensor
                                  ] ;
                  owl:disjointWith :PhysicalAsset .


###  https://example.org/maritime/ontology#Machine
:Machine rdf:type owl:Class ;
         rdfs:subClassOf :PhysicalAsset ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :locatedAt ;
                           owl:someValuesFrom :ProductionCell
                         ] .


###  https://example.org/maritime/ontology#PhysicalAsset
:PhysicalAsset rdf:type owl:Class .


###  https://example.org/maritime/ontology#ProductionCell
:ProductionCell rdf:type owl:Class ;
                rdfs:subClassOf :PhysicalAsset ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :partOf ;
                                  owl:someValuesFrom :Facility
                                ] .


###  https://example.org/maritime/ontology#Sensor
:Sensor rdf:type owl:Class ;
        rdfs:subClassOf :PhysicalAsset ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :partOf ;
                          owl:someValuesFrom :Machine
                        ] .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Facility
                :Machine
                :ProductionCell
                :Sensor
              )
] .


