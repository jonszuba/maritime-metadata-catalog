@prefix ex: <https://example.org/maritime/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Common physical asset metadata
ex:PhysicalAssetShape
    a sh:NodeShape ;
    sh:targetClass ex:Facility,
                   ex:ProductionCell,
                   ex:Machine,
                   ex:Sensor ;

    sh:property [
        sh:path dcterms:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "Every physical asset must have one identifier." ;
    ] ;

    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "Every physical asset must have one name." ;
    ] .

# Facility validation
ex:FacilityShape
    a sh:NodeShape ;
    sh:targetClass ex:Facility ;

    sh:property [
        sh:path ex:partOf ;
        sh:maxCount 0 ;
        sh:message "A facility must not have a parent asset." ;
    ] .

# Production cell validation
ex:ProductionCellShape
    a sh:NodeShape ;
    sh:targetClass ex:ProductionCell ;

    sh:property [
        sh:path ex:partOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ex:Facility ;
        sh:message "A production cell must belong to one facility." ;
    ] .

# Machine validation
ex:MachineShape
    a sh:NodeShape ;
    sh:targetClass ex:Machine ;

    sh:property [
        sh:path ex:locatedAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ex:ProductionCell ;
        sh:message "A machine must be located at one production cell." ;
    ] ;

    sh:property [
        sh:path ex:partOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ex:ProductionCell ;
        sh:equals ex:locatedAt ;
        sh:message "Machine parent and location must identify the same production cell." ;
    ] .

# Sensor validation
ex:SensorShape
    a sh:NodeShape ;
    sh:targetClass ex:Sensor ;

    sh:property [
        sh:path ex:partOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ex:Machine ;
        sh:message "A sensor must belong to one machine." ;
    ] .

# Industrial signal validation
ex:IndustrialSignalShape
    a sh:NodeShape ;
    sh:targetClass ex:IndustrialSignal ;

    sh:property [
        sh:path dcterms:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "A signal must have one identifier." ;
    ] ;

    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "A signal must have one name." ;
    ] ;

    sh:property [
        sh:path ex:generatedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class ex:Sensor ;
        sh:message "A signal must be generated by one sensor." ;
    ] ;

    sh:property [
        sh:path ex:measurementUnit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "A signal must have one measurement unit." ;
    ] .
